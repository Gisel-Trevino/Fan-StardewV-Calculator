@page
@model SVprueba.Pages.CalculadoraVentaModel
@{
    ViewData["Title"] = "Stardew Valley Calculator";
}

<div class="board">
    <div style="text-align: center; margin-top: 50px;">
        <h1 class="tituloStardew">@Model.Mensaje</h1>
    </div>

        <div class="d-flex justify-content-between align-items-start w-100 px-3 mt-4">
        <div class= "d-flex flex-column gap-3">
                <form method="post">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="glue">
                            <label class="mb-0">Buscar cultivo: </label>
                            <select id="select-cultivos" asp-for="CultivoSeleccionado" placeholder="Seleccione un cultivo" class="select" style="width: 300px;">
                                <option value="">Seleccione un cultivo</option>

                                @foreach (var cultivo in Model.ListaCultivos)
                                {
                                    <option value="@cultivo.name" data-image="@cultivo.image">@cultivo.name</option>
                                }
                            </select>
                        </div><br/>
                    </div>

                    <br />
                    <div>
                        <label class="mb-0">Seleccione su profesión: 
                            <br />
                            <input type="radio" name="profesion" value=0 checked> Ninguna
                            <input type="radio" name="profesion" value=0.1> Agricultor
                            <input type="radio" name="profesion" value=0.4> Labrador
                        </label>
                    </div>

                    <br />
                    <div>
                        <label>¿Quiere procesar su cultivo?
                            <input type="radio" name="procesar" value=1> Si
                            <input type="radio" name="procesar" value=0 checked> No
                        </label>

                        <br />
                        <label>Seleccione como procesara su cultivo:</label>
                        <select id="select-maquinas" placeholder="Seleccione una maquina" class="select" style="width: 300px;">
                            <option value="0">Seleccione una maquina</option>
                        </select>
                    </div>

                    <br />
                    <div class="d-flex flex-column gap-2">
                        <label class="mb-0">
                            Seleccione la cantidad de cultivos a vender: 
                            <input type="number" min=1 placeholder="ej. 10" class="inputt">
                        </label>

                        <label class="mb-0">
                            Seleccione la cantidad de cultivos de plata que va a vender: 
                            <input type="number" min=1 placeholder="ej. 10" class="inputt">
                        </label>

                        <label class="mb-0">
                            Seleccione la cantidad de cultivos de oro que va a vender: 
                            <input type="number" min=1 placeholder="ej. 10" class="inputt">
                        </label>

                        <label class="mb-0">
                            Seleccione la cantidad de cultivos iridio que va a vender: 
                            <input type="number" min=1 placeholder="ej. 10" class="inputt">
                        </label>

                        <button type="submit" class="btton">Calcular</button>
                    </div>  
                </form>
                
            @if(Model.Mostrar){
                <div class="mt-2 fw-bold">
                    <p class="mb-0">El precio total es: </p> 
                </div>
            }
            <br>

            <a class="btton" asp-page="/Index">Volver</a>
        </div>

        <div class="ms-auto">
            <div class="items-center crops-background">
                <img 
                id="imagen-cultivo"
                src="@(string.IsNullOrEmpty(Model.ObjCultivoSel?.image) ? 
                "https://stardewvalleywiki.com/mediawiki/images/c/cf/Springobjects468.png"
                : Model.ObjCultivoSel.image)" 
                alt="@(Model.ObjCultivoSel?.name ?? "Cultivo")" 
                style="width: 3.5rem; height: 3.5rem; padding: 0.5rem;">
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet"/>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    <script>
        new TomSelect("#select-cultivos", {
            create: false,
            onChange: function(value) {
                var imgEl = document.getElementById("imagen-cultivo");
                var selectEl = document.getElementById("select-cultivos");
                
                if (!value) {
                    imgEl.src = "https://stardewvalleywiki.com/mediawiki/images/c/cf/Springobjects468.png";
                    return;
                }

                var optionEl = selectEl.querySelector('option[value="' + CSS.escape(value) + '"]');
                var imageUrl = optionEl ? optionEl.getAttribute("data-image") : "";

                if (imageUrl && imageUrl.trim() !== "") {
                    imgEl.src = imageUrl;
                } else {
                    imgEl.src = "https://stardewvalleywiki.com/mediawiki/images/c/cf/Springobjects468.png";
                }
            }
        });

        new TomSelect("#select-maquinas", {
            create: false,
            //onChange: function(value) {
                // Aquí puedes agregar la lógica para manejar el cambio de selección de la máquina
                //console.log("Máquina seleccionada:", value);
            //}
        });
    </script>
}